<!-- <?xml version="1.0" encoding="UTF-8"?> -->
<odoo>
    <!-- Student Management Views -->
    <record id="view_student_tree" model="ir.ui.view">
        <field name="name">student.management.tree</field>
        <field name="model">student.management</field>
        <field name="type">tree</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <tree string="Students">
                <field name="name"/>
                <field name="registration_number"/>
                <field name="age"/>
                <field name="gender"/>
                <field name="year_of_study"/>
            </tree>
        </field>
    </record>

    <record id="view_student_form" model="ir.ui.view">
        <field name="name">student.management.form</field>
        <field name="model">student.management</field>
        <field name="type">form</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <group>
                        <field name="profile_photo" widget="image" class="oe_avatar"/>
                        <field name="name"/>
                        <field name="registration_number"/>
                        <field name="date_of_birth"/>
                        <field name="age" readonly="1"/>
                        <field name="gender"/>
                        <field name="email"/>
                        <field name="phone"/>
                        <field name="address"/>
                        <field name="year_of_study"/>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <tree>
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </tree>
                                <form>
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Management Views -->
    <record id="view_course_tree" model="ir.ui.view">
        <field name="name">course.management.tree</field>
        <field name="model">course.management</field>
        <field name="type">tree</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="name"/>
                <field name="code"/>
            </tree>
        </field>
    </record>

    <record id="view_course_form" model="ir.ui.view">
        <field name="name">course.management.form</field>
        <field name="model">course.management</field>
        <field name="type">form</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <tree>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </tree>
                                <form>
                                    <field name="student_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="status"/>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Enrollment Management Views -->
    <record id="view_enrollment_tree" model="ir.ui.view">
        <field name="name">student.enrollment.tree</field>
        <field name="model">student.enrollment</field>
        <field name="type">tree</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <tree string="Enrollments">
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="enrollment_date"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="view_enrollment_form" model="ir.ui.view">
        <field name="name">student.enrollment.form</field>
        <field name="model">student.enrollment</field>
        <field name="type">form</field> <!-- Add this line -->
        <field name="arch" type="xml">
            <form string="Enrollment">
                <sheet>
                    <group>
                        <field name="student_id"/>
                        <field name="course_id"/>
                        <field name="enrollment_date"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Student Management -->
    <record id="action_student_management" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">student.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Course Management -->
    <record id="action_course_management" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">course.management</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Action for Enrollment Management -->
    <record id="action_enrollment_management" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">student.enrollment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_student_management_root" name="Student Management"/>
    <menuitem id="menu_student_management" name="Students" parent="menu_student_management_root" action="action_student_management"/>
    <menuitem id="menu_course_management" name="Courses" parent="menu_student_management_root" action="action_course_management"/>
    <menuitem id="menu_enrollment_management" name="Enrollments" parent="menu_student_management_root" action="action_enrollment_management"/>
</odoo>